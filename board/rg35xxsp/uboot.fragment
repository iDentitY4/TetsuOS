# Boot diagnostics, for debugging without a serial adapter. Before each boot,
# U-Boot counts the boot in bootcount.txt on the FAT partition, and dumps its
# environment to uboot-env.txt. If these files appear, the boot ROM, SPL, RAM
# setup, TF-A, U-Boot and SD access all worked. The count shows reboot loops.
CONFIG_FS_FAT=y
CONFIG_CMD_FAT=y
CONFIG_FAT_WRITE=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_EXPORTENV=y
CONFIG_CMD_IMPORTENV=y
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="setenv bootcount 0; if fatload mmc 0:1 ${scriptaddr} bootcount.txt; then env import -t ${scriptaddr} ${filesize}; fi; setexpr bootcount ${bootcount} + 1; env export -t ${scriptaddr} bootcount; fatwrite mmc 0:1 ${scriptaddr} bootcount.txt ${filesize}; env export -t ${scriptaddr}; fatwrite mmc 0:1 ${scriptaddr} uboot-env.txt ${filesize}"

# RAM setup for this unit, which has LPDDR3 rather than the LPDDR4 assumed by
# anbernic_rg35xx_h700_defconfig. Values read from the boot0 that works on this
# device (muOS card, offsets 0x38-0xac). ROCKNIX's generic LPDDR3 config has the
# same type and voltage, with slightly different TPR11 and TPR12.
# CONFIG_SUNXI_DRAM_H616_LPDDR4 is not set
CONFIG_SUNXI_DRAM_H616_LPDDR3=y
CONFIG_DRAM_CLK=672
CONFIG_DRAM_SUNXI_DX_ODT=0x06060606
CONFIG_DRAM_SUNXI_DX_DRI=0x0d0d0d0d
CONFIG_DRAM_SUNXI_CA_DRI=0x1919
CONFIG_DRAM_SUNXI_ODT_EN=0x9988eeee
CONFIG_DRAM_SUNXI_TPR2=0x1
CONFIG_DRAM_SUNXI_TPR6=0x2fb08080
CONFIG_DRAM_SUNXI_TPR10=0x402f4489
CONFIG_DRAM_SUNXI_TPR11=0x10131113
CONFIG_DRAM_SUNXI_TPR12=0x0f0e0e0f
CONFIG_AXP_DCDC3_VOLT=1200
