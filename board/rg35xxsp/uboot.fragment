# Boot straight away. The default waits 2 seconds for a key on the serial console,
# which this unit has no adapter for.
CONFIG_BOOTDELAY=0

# RAM setup for this unit, which has LPDDR3 rather than the LPDDR4 assumed by
# anbernic_rg35xx_h700_defconfig. Values read from the boot0 that works on this
# device (muOS card, offsets 0x38-0xac). ROCKNIX's generic LPDDR3 config has the
# same type and voltage, with slightly different TPR11 and TPR12.
# CONFIG_SUNXI_DRAM_H616_LPDDR4 is not set
CONFIG_SUNXI_DRAM_H616_LPDDR3=y
CONFIG_DRAM_CLK=672
CONFIG_DRAM_SUNXI_DX_ODT=0x06060606
CONFIG_DRAM_SUNXI_DX_DRI=0x0d0d0d0d
CONFIG_DRAM_SUNXI_CA_DRI=0x1919
CONFIG_DRAM_SUNXI_ODT_EN=0x9988eeee
CONFIG_DRAM_SUNXI_TPR2=0x1
CONFIG_DRAM_SUNXI_TPR6=0x2fb08080
CONFIG_DRAM_SUNXI_TPR10=0x402f4489
CONFIG_DRAM_SUNXI_TPR11=0x10131113
CONFIG_DRAM_SUNXI_TPR12=0x0f0e0e0f
CONFIG_AXP_DCDC3_VOLT=1200

# A/B root slots with fallback (docs/features.md, "Updates over Wi-Fi"). RAUC's bootmeth
# boots the first slot in BOOT_ORDER with tries left, counting each try down in the
# environment; Linux puts the count back once it has started. After 3 failed tries the
# other slot boots. Each slot is its own boot partition: slot A is partition 2, B is 3.
CONFIG_BOOTMETH_RAUC=y
CONFIG_BOOTMETH_RAUC_BOOT_ORDER="A B"
CONFIG_BOOTMETH_RAUC_PARTITIONS="2,2 3,3"
CONFIG_BOOTMETH_RAUC_DEFAULT_TRIES=3
CONFIG_BOOTMETH_RAUC_RESET_ALL_ZERO_TRIES=y
# The environment holds the count, in two copies on TETSU-BOOT (partition 1), written in
# turn, so a power cut while one is written leaves the other. The default ":auto" would
# be the bootable partition, the ext4 root, where saving fails.
CONFIG_ENV_FAT_DEVICE_AND_PART=":1"
CONFIG_ENV_REDUNDANT=y
# bootstd, where the RAUC bootmeth takes the whole card before the extlinux bootmeth
# looks at its partitions; if it fails (no slot script), the old script boots the
# partition with the bootable flag, slot A, as before. Without CONFIG_BOOTSTD_FULL,
# bootflow scan takes no flags or device (it refuses them) and boots the first bootflow,
# trying the devices in boot_targets' order, mmc0 first.
CONFIG_BOOTCOMMAND="bootflow scan; run distro_bootcmd"
