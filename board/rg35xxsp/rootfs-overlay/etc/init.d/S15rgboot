#!/bin/sh
# Mounts the card's FAT partition, which holds the games and saves.

case "$1" in
start)
	dev="$(blkid | grep 'LABEL="RGBOOT"' | head -n 1 | cut -d: -f1)"
	[ -n "$dev" ] || exit 1
	mkdir -p /mnt/boot
	mount -t vfat "$dev" /mnt/boot
	;;
stop)
	umount /mnt/boot
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
