#!/bin/sh
# Mounts the card's TETSU-DATA partition, which holds the games and saves.

case "$1" in
start)
	dev="$(blkid | grep 'LABEL="TETSU-DATA"' | head -n 1 | cut -d: -f1)"
	[ -n "$dev" ] || exit 1
	mkdir -p /mnt/data
	# Fixed permissions: vfat would otherwise take them from the caller's umask
	mount -t vfat -o umask=022 "$dev" /mnt/data || exit 1
	mkdir -p /mnt/data/roms /mnt/data/saves
	;;
stop)
	umount /mnt/data
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
