#!/bin/sh
# The boot jingle, if it's on in the settings, starts as soon as the sound card is set up.
# It plays in the background so the other scripts carry on, and the launcher finds it
# through the file and keeps the boot logo up until it ends.

case "$1" in
start)
	/usr/bin/launcher --jingle </dev/null >/var/log/jingle.log 2>&1 &
	echo $! > /run/jingle.pid
	;;
stop)
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
