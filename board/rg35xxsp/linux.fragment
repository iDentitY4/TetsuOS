# Added to linux.defconfig, which has modules off. Set new drivers to y here, because
# nothing on the device loads modules.

# Display pipeline
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_SUN8I_DW_HDMI=y
CONFIG_SUN8I_DE2_CCU=y
CONFIG_SUNXI_CCU=y

# Panel: NV3052C controller, configured over bit-banged SPI
CONFIG_DRM_PANEL_NEWVISION_NV3052C=y
CONFIG_SPI=y
CONFIG_SPI_GPIO=y

# Backlight
CONFIG_PWM=y
CONFIG_PWM_SUN8I=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# /dev/fb0 and on-screen boot messages
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# console=ttynull: kernel messages stay off the screen at any loglevel. With
# console=tty3 they still landed on tty1, over the boot logo, because tty3 isn't
# allocated that early.
CONFIG_NULL_TTY=y

# Power: AXP717 PMIC supplies the panel and pin banks
CONFIG_I2C=y
CONFIG_I2C_MV64XXX=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# Battery level and charging state, through the AXP717
CONFIG_AXP20X_ADC=y
CONFIG_AXP20X_POWER=y
CONFIG_BATTERY_AXP20X=y

# Power button, through the AXP717
CONFIG_INPUT_AXP20X_PEK=y

# SD card and the FAT boot partition that receives boot logs
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Audio: the H616 codec, which plays through DMA
CONFIG_DMA_SUN6I=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SUN4I_CODEC=y

# CPU speed scaling, using the speeds rated for each chip. Without it, the CPU stays
# at the 1008 MHz that U-Boot sets.
CONFIG_ARM_ALLWINNER_SUN50I_CPUFREQ_NVMEM=y

# GPU: Mali-G31, which can't probe without its power domain driver
CONFIG_DRM_PANFROST=y
CONFIG_SUN50I_H6_PRCM_PPU=y

# USB-C serial console and network link, as one composite gadget. The
# controller has 4 IN and 4 OUT endpoints, and serial plus Ethernet need
# 4 IN and 2 OUT.
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_GADGET=y
# CONFIG_USB_G_SERIAL is not set
CONFIG_USB_CDC_COMPOSITE=y

# Wi-Fi: Realtek RTL8821CS on SDIO, ID 024C:C821. The firmware and the regulatory
# database are built in, because the driver probes before the root filesystem is
# mounted. external.mk points CONFIG_EXTRA_FIRMWARE_DIR at the target's firmware.
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=y
CONFIG_RTW88_8821CS=y
CONFIG_EXTRA_FIRMWARE="rtw88/rtw8821c_fw.bin regulatory.db regulatory.db.p7s"
