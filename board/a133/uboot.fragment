# Added to trimui_brick_defconfig (patches/uboot/0003), which has the RAM settings.

# Boot straight away. The default waits 2 seconds for a key on the serial console.
CONFIG_BOOTDELAY=0

# DCDC2 is on at boot and its use is unknown (the vendor's device tree only names it
# axp2202-dcdc2), but the SPL always programs it, and 0 would turn it off. 1000 mV is the
# AXP717 default here and what the TrimUI Smart Pro's vdd-gpu-sys runs at. It must be
# checked against the tester's reading of the PMIC's register 0x84 before a card goes out.
CONFIG_AXP_DCDC2_VOLT=1000

# A/B root slots with fallback, as on the H700 (board/h700/uboot.fragment has the details):
# the RAUC bootmeth boots the first slot in BOOT_ORDER with tries left, and the other one
# after 3 failed tries. The count is kept on TETSU-BOOT (partition 1), in two copies.
CONFIG_BOOTMETH_RAUC=y
CONFIG_BOOTMETH_RAUC_BOOT_ORDER="A B"
CONFIG_BOOTMETH_RAUC_PARTITIONS="2,2 3,3"
CONFIG_BOOTMETH_RAUC_DEFAULT_TRIES=3
CONFIG_BOOTMETH_RAUC_RESET_ALL_ZERO_TRIES=y
CONFIG_ENV_FAT_DEVICE_AND_PART=":1"
CONFIG_ENV_REDUNDANT=y
CONFIG_BOOTCOMMAND="bootflow scan; run distro_bootcmd"
