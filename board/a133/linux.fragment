# Added to board/h700/linux.defconfig, which has modules off. Set new drivers to y here,
# because nothing on the device loads modules. This is the bring-up's set: the microSD
# slot, the PMIC and the USB-C port as a USB device. The A133's clocks and pins
# (SUN50I_A100_CCU, PINCTRL_SUN50I_A100) are already on through ARCH_SUNXI.

# On-screen boot messages need a display, which the Brick doesn't have yet; this keeps
# the kernel's messages off any console, as on the H700
CONFIG_NULL_TTY=y

# Power: the AXP717 PMIC (the vendor calls it the AXP2202) on the PRCM's I2C
CONFIG_I2C=y
CONFIG_I2C_MV64XXX=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_AXP20X_ADC=y
# Power button
CONFIG_INPUT_AXP20X_PEK=y

# The microSD card, the FAT boot partition that receives boot logs, and exFAT
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DMA_SUN6I=y

# USB-C gadget, set up by /usr/sbin/usb-gadget through configfs, as on the H700: serial
# console plus network link, at 10.35.35.1
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_GADGET=y
# CONFIG_USB_G_SERIAL is not set
# CONFIG_USB_CDC_COMPOSITE is not set
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
