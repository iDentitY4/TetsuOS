Subject: [PATCH 3/3] sunxi: add the TrimUI Brick

The TrimUI Brick has an A133P with an AXP717 PMIC and LPDDR3. The RAM
settings are those its boot0 hands to Linux in the vendor device tree's
/dram node (dram_para[], as boot0 ran them): 672 MHz, LPDDR3, with
TPR11 and TPR12 the delays boot0 used. The PMIC sets the RAM rail,
DCDC3, to 1.2V for LPDDR3.

The CPU is supplied by a TCS4838, which U-Boot doesn't drive, so its
voltage is whatever it starts at; the SPL clocks the CPU at 816 MHz,
which the A100's operating points allow at 0.9V to 0.94V, instead of
1008 MHz. The device tree is the Linux one, which only enables the
microSD slot: U-Boot never sees the eMMC with the vendor's system.
---
 configs/trimui_brick_defconfig                |  30 ++++
 .../allwinner/sun50i-a133-trimui-brick.dts    | 131 ++++++++++++++++++
 2 files changed, 161 insertions(+)
 create mode 100644 configs/trimui_brick_defconfig
 create mode 100644 dts/upstream/src/arm64/allwinner/sun50i-a133-trimui-brick.dts

diff --git a/configs/trimui_brick_defconfig b/configs/trimui_brick_defconfig
new file mode 100644
index 00000000..e27e9ed4
--- /dev/null
+++ b/configs/trimui_brick_defconfig
@@ -0,0 +1,30 @@
+CONFIG_ARM=y
+CONFIG_ARCH_SUNXI=y
+CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-a133-trimui-brick"
+CONFIG_SPL=y
+CONFIG_DRAM_CLK=672
+CONFIG_DRAM_SUNXI_DX_ODT=0x6060606
+CONFIG_DRAM_SUNXI_DX_DRI=0xc0c0c0c
+CONFIG_DRAM_SUNXI_CA_DRI=0x1919
+CONFIG_DRAM_SUNXI_PARA0=0x1b181215
+CONFIG_DRAM_SUNXI_TPR0=0x16161a1e
+CONFIG_DRAM_SUNXI_TPR1=0x80000000
+CONFIG_DRAM_SUNXI_TPR6=0xb20000
+CONFIG_DRAM_SUNXI_TPR10=0x2fbbdf
+CONFIG_DRAM_SUNXI_TPR11=0x1a181011
+CONFIG_DRAM_SUNXI_TPR12=0xf111110
+CONFIG_DRAM_SUNXI_TPR13=0x1007521
+CONFIG_DRAM_SUNXI_TPR14=0x1e1e2020
+CONFIG_MACH_SUN50I_A133=y
+CONFIG_SUNXI_DRAM_A133_LPDDR3=y
+CONFIG_SYS_CLK_FREQ=816000000
+CONFIG_R_I2C_ENABLE=y
+# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
+CONFIG_SPL_I2C=y
+CONFIG_SPL_SYS_I2C_LEGACY=y
+CONFIG_SYS_I2C_MVTWSI=y
+CONFIG_SYS_I2C_SLAVE=0x7f
+CONFIG_SYS_I2C_SPEED=400000
+CONFIG_AXP717_POWER=y
+CONFIG_AXP_I2C_ADDRESS=0x34
+CONFIG_AXP_DCDC3_VOLT=1200
diff --git a/dts/upstream/src/arm64/allwinner/sun50i-a133-trimui-brick.dts b/dts/upstream/src/arm64/allwinner/sun50i-a133-trimui-brick.dts
new file mode 100644
index 00000000..eac8853d
--- /dev/null
+++ b/dts/upstream/src/arm64/allwinner/sun50i-a133-trimui-brick.dts
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * TrimUI Brick (TG3040): Allwinner A133P, AXP717 PMIC, a TCS4838 for the
+ * CPU, LPDDR3, a microSD slot, eMMC, a 1024x768 MIPI DSI panel and an
+ * XRadio XR829 for Wi-Fi and Bluetooth.
+ *
+ * A first bring-up: the SD card, the PMIC and the USB-C port as a USB
+ * device, so that the board can be reached over USB. Everything here comes
+ * from the vendor's device tree of a running unit.
+ *
+ * The eMMC (mmc2), with the vendor's system on it, must stay disabled until
+ * the system knows it: Tetsu OS's /usr/sbin/cards takes the controller at
+ * 0x4022000 for the H700's second card slot, and would mount and share the
+ * eMMC as a removable card.
+ */
+
+/dts-v1/;
+
+#include "sun50i-a100.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	model = "TrimUI Brick";
+	compatible = "trimui,brick", "allwinner,sun50i-a100";
+
+	aliases {
+		mmc0 = &mmc0;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * TF-A's A133 port runs BL31 from the start of DRAM, in up to
+		 * 256 KiB. It adds this itself, but not every bootloader
+		 * passes it on.
+		 */
+		secmon@40000000 {
+			reg = <0x0 0x40000000 0x0 0x40000>;
+			no-map;
+		};
+	};
+
+	reg_vcc5v: regulator-vcc5v {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-5v";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-always-on;
+	};
+};
+
+/*
+ * No CPU operating points: the CPU is supplied by the TCS4838, which has no
+ * driver yet, so cpufreq could raise the clock without the voltage. The CPU
+ * stays at the clock U-Boot set.
+ */
+
+/* microSD, card detect on PF6 */
+&mmc0 {
+	vmmc-supply = <&reg_cldo3>;
+	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>; /* PF6 */
+	bus-width = <4>;
+	status = "okay";
+};
+
+&r_i2c0 {
+	status = "okay";
+
+	axp717: pmic@34 {
+		compatible = "x-powers,axp717";
+		reg = <0x34>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-parent = <&r_intc>;
+		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
+
+		vin1-supply = <&reg_vcc5v>;
+		vin2-supply = <&reg_vcc5v>;
+		vin3-supply = <&reg_vcc5v>;
+		vin4-supply = <&reg_vcc5v>;
+
+		axp_adc: adc {
+			compatible = "x-powers,axp717-adc";
+			#io-channel-cells = <1>;
+		};
+
+		/*
+		 * Only the rails this bring-up needs. The rest stay as the
+		 * PMIC starts them, which Linux leaves alone while they
+		 * aren't described here.
+		 */
+		regulators {
+			/*
+			 * vdd-dram. The SPL sets the voltage for the RAM it
+			 * finds (1.2V for LPDDR3); a range keeps it there.
+			 */
+			reg_dcdc3: dcdc3 {
+				regulator-always-on;
+				regulator-min-microvolt = <1100000>;
+				regulator-max-microvolt = <1200000>;
+				regulator-name = "vdd-dram";
+			};
+
+			/* vcc-io and the microSD slot, 3.3V in the vendor's */
+			reg_cldo3: cldo3 {
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc-io";
+			};
+		};
+	};
+};
+
+/*
+ * The USB-C port as a USB device only. EHCI0 and OHCI0 share PHY 0 and
+ * stay disabled (as in the dtsi), so they never switch it to host mode.
+ */
+&usb_otg {
+	dr_mode = "peripheral";
+	status = "okay";
+};
+
+&usbphy {
+	status = "okay";
+};
