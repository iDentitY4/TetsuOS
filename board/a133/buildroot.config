# The A133 family's part of the Buildroot configuration, so far the TrimUI Brick only, and
# so far a bring-up: the microSD slot, the PMIC and the USB-C port as a USB device, to
# reach it over USB (docs/developer/hardware.md, "TrimUI Brick"). Built with
# `make BOARD=a133`, into output-a133/. The Makefile puts this after configs/common.config,
# so a line here overrides one there.

# CPU: Allwinner A133P, quad Cortex-A53
BR2_aarch64=y
BR2_cortex_a53=y

# Toolchain: the same one as the H700's, built once in output-toolchain/
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(BR2_EXTERNAL_TETSU_PATH)/output-toolchain/host"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="aarch64-buildroot-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_7_1=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
# glibc no longer has RPC
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set

# System. The init scripts and helpers are the H700's: they find devices by name.
BR2_TARGET_GENERIC_HOSTNAME="tetsu-brick"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_TETSU_PATH)/board/a133/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_TETSU_PATH)/board/h700/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_TETSU_PATH)/board/a133/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_TETSU_PATH)/board/a133/post-image.sh"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_TETSU_PATH)/board/h700/busybox.fragment"

# Kernel: the H700's version and base configuration, with this board's drivers
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.2.15"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_TETSU_PATH)/board/h700/linux.defconfig"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_TETSU_PATH)/board/a133/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/sun50i-a133-trimui-brick"
BR2_LINUX_KERNEL_DTB_KEEP_DIRNAME=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# In each root slot's /boot, as on the H700
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Bootloader chain: TF-A BL31 + U-Boot SPL. TF-A has the A133 since commit a584e8632
# (June 2026) on its master branch, in no release yet; this is master on 2026-11-04.
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_GIT=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_REPO_URL="https://github.com/ARM-software/arm-trusted-firmware.git"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_REPO_VERSION="5f1b5d6d8b3bd93fa4735e41de49cda888c8396f"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="sun50i_a133"
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2026.10"
# Added by patches/uboot/0003
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="trimui_brick"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_TETSU_PATH)/board/a133/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="u-boot-sunxi-with-spl.bin"
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="SCP=/dev/null"

# No GPU drivers: the Brick's PowerVR has none that the launcher needs, as it draws in
# software. No Wi-Fi firmware: its XRadio XR829 has no mainline driver.
# mkimage, which makes each root slot's boot.scr (post-build.sh)
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
