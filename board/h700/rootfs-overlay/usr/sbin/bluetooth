#!/bin/sh
# Turns Bluetooth on or off: D-Bus, bluetoothd and bluealsa, which don't start at boot
# (see post-build.sh), and the radio through rfkill. "status" prints on or off.
# bluealsa plays to headphones (A2DP) through the ALSA device "bluealsa".
#
# rtw88's deep power save, which left the Wi-Fi firmware stuck with Bluetooth on and
# off, is off for good: rtw88_core.disable_lps_deep=Y in extlinux.conf.
BLUEALSA_PID=/run/bluealsa.pid

radio() {
	for rfkill in /sys/class/rfkill/rfkill*; do
		[ "$(cat "$rfkill/type" 2>/dev/null)" = bluetooth ] && echo "$1" > "$rfkill/soft"
	done
}

case "$1" in
on)
	# The launcher turns it on each time it starts.
	pidof bluetoothd > /dev/null && exit 0
	radio 0
	/etc/init.d/dbus-daemon start
	/etc/init.d/bluetoothd start
	start-stop-daemon -S -b -m -p "$BLUEALSA_PID" -x /usr/bin/bluealsa -- -p a2dp-source
	;;
off)
	start-stop-daemon -K -q -p "$BLUEALSA_PID" && rm -f "$BLUEALSA_PID"
	/etc/init.d/bluetoothd stop
	/etc/init.d/dbus-daemon stop
	radio 1
	;;
status)
	if pidof bluetoothd > /dev/null; then echo on; else echo off; fi
	;;
*)
	echo "Usage: $0 {on|off|status}"
	exit 1
	;;
esac
