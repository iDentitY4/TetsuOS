#!/bin/sh
# Mounts the card's TETSU-DATA partition, which holds the games and saves, and the
# games on a second card in TF2, if there is one (see /usr/sbin/cards).

# Prints 1 if a FAT file system's dirty bit is set. It is in the boot sector's state
# byte: at offset 65 on FAT32, which has 0 in the 16-bit FAT size at 22, else at 37.
dirty() {
	fat16_size="$(dd if="$1" bs=1 skip=22 count=2 2>/dev/null | od -An -tu2 | tr -d ' ')"
	[ "$fat16_size" = 0 ] && offset=65 || offset=37
	state="$(dd if="$1" bs=1 skip="$offset" count=1 2>/dev/null | od -An -tu1 | tr -d ' ')"
	echo $(( ${state:-0} & 1 ))
}

# The games that come with Tetsu OS: Cave Story and Freedoom. Each is copied to the games
# once, so it can be deleted like any other and stays deleted; the list holds those copied.
BUNDLED=/usr/share/tetsu/games
COPIED=/mnt/data/bundled-games.txt

copy_bundled_games() {
	for game in "$BUNDLED"/*; do
		[ -d "$game" ] || continue
		name="${game##*/}"
		grep -qxF "$name" "$COPIED" 2>/dev/null && continue
		# A folder of that name already is the user's, so it is left as it is. Copying
		# goes to a name with a dot, which the launcher doesn't list, until it is complete;
		# one left by a copy that was cut off goes first, or cp would copy into it.
		rm -rf /mnt/data/roms/.copying
		if [ -e "/mnt/data/roms/$name" ] ||
			{ cp -r "$game" /mnt/data/roms/.copying && mv /mnt/data/roms/.copying "/mnt/data/roms/$name"; }; then
			echo "$name" >> "$COPIED"
			echo "S15data: copied $name to the games" > /dev/kmsg
		else
			# Such as a full card: tried again at the next start
			rm -rf /mnt/data/roms/.copying
			echo "S15data: could not copy $name to the games" > /dev/kmsg
		fi
	done
}

# Copies them once the boot jingle (S21jingle) has ended, in the background and at low
# priority. Copying 60 MB while the jingle played kept the card writing, and the
# launcher's code, read from the card as it ran, drew 2 frames of the animation in 4 s.
# The games appear when the launcher reads the games again, as it does after the setup.
copy_bundled_games_later() {
	# The jingle's process, which S21jingle writes to /run/jingle.pid and the launcher
	# removes about 200 ms later, once it has read it: kept once read. At most 15 s, as a
	# start from USB power has no jingle.
	pid=""
	for _ in $(seq 750); do
		[ -n "$pid" ] || pid="$(cat /run/jingle.pid 2>/dev/null)"
		[ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null && break
		sleep 0.02
	done
	copy_bundled_games
}

case "$1" in
start)
	# Only TF1's: a Tetsu card in TF2 has a TETSU-DATA too
	dev="$(/usr/sbin/cards data)"
	# A card just written with an image writer has none yet
	[ -n "$dev" ] || { /usr/sbin/data-partition && dev="$(/usr/sbin/cards data)"; }
	[ -n "$dev" ] || exit 1
	# A power cut leaves the file system marked dirty, and maybe damaged. Unrepaired, the
	# kernel finds the damage later, makes the partition read-only, and from then on
	# every save, resume point and setting is lost without a sign.
	if [ "$(dirty "$dev")" = 1 ]; then
		echo "S15data: $dev was not unmounted cleanly, repairing it" > /dev/kmsg
		fsck.fat -a -w "$dev" > /var/log/fsck-data.log 2>&1
	fi
	mkdir -p /mnt/data
	# Fixed permissions: vfat would otherwise take them from the caller's umask
	mount -t vfat -o umask=022 "$dev" /mnt/data || exit 1
	mkdir -p /mnt/data/roms /mnt/data/saves
	# Only when there is something to copy, as on the first start
	for game in "$BUNDLED"/*; do
		[ -d "$game" ] || continue
		grep -qxF "${game##*/}" "$COPIED" 2>/dev/null && continue
		copy_bundled_games_later </dev/null >/dev/null 2>&1 &
		break
	done
	# The launcher mounts a card put in later
	/usr/sbin/cards mount
	exit 0
	;;
stop)
	/usr/sbin/cards unmount
	umount /mnt/data
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
