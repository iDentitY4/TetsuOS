#!/bin/sh
# The codec starts muted, and the path must be complete for its DAC to run:
# with the DAC switch off, playback fails with an I/O error.

case "$1" in
start)
	amixer -q sset 'DAC' 100% on
	amixer -q sset 'Line Out' 80% on
	amixer -q sset 'Line Out Source' Stereo
	;;
stop)
	# The amp stays on for 5 s after a sound, longer than the rest of a shutdown takes,
	# and it crackles if the power goes while it's on. The launcher has exited by now.
	amixer -q sset 'Line Out' off
	amixer -q sset 'Speaker' off
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
