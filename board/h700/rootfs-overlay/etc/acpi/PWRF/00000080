#!/bin/sh
# Power button pressed. On the charging screen, or before it while booting from USB power,
# it starts the device fully: the launcher goes on to the menus once the file is gone.
if [ -e /run/charging ]; then
	rm -f /run/charging
	exit 0
fi
# Otherwise the launcher shows the shutdown screen, then shut down cleanly.
# The menus and a running game both draw it on SIGUSR1; a moment lets them finish.
killall -q -USR1 launcher && sleep 0.2
exec /sbin/poweroff
