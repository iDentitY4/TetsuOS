# The H700 family's part of the Buildroot configuration: one image for every H700
# device, with each one's device tree (boot.cmd picks one). The Makefile puts it after
# configs/common.config, so a line here overrides one there.

# CPU: Allwinner H700, quad Cortex-A53
BR2_aarch64=y
BR2_cortex_a53=y

# Toolchain: glibc, so emulators and libretro cores are straightforward. It is built
# once in output-toolchain/ from configs/toolchain_a53_defconfig (make toolchain) and
# used from there, so cleaning this build doesn't rebuild the compiler.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(BR2_EXTERNAL_TETSU_PATH)/output-toolchain/host"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="aarch64-buildroot-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_7_1=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
# glibc no longer has RPC
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set

# System
BR2_TARGET_GENERIC_HOSTNAME="tetsu-rg35xxsp"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_TETSU_PATH)/board/h700/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_TETSU_PATH)/board/h700/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_TETSU_PATH)/board/h700/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_TETSU_PATH)/board/h700/post-image.sh"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_TETSU_PATH)/board/h700/busybox.fragment"

# Kernel: 7.2.15 is the base the display patches were checked against
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.2.15"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_TETSU_PATH)/board/h700/linux.defconfig"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_TETSU_PATH)/board/h700/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# Every device in the image, the SP first: make-update.sh lists them all in the manifest
BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/sun50i-h700-anbernic-rg35xx-sp allwinner/sun50i-h700-anbernic-rg35xx-plus allwinner/sun50i-h700-anbernic-rg35xx-h allwinner/sun50i-h700-anbernic-rg35xx-2024"
# In /boot/allwinner/, the names U-Boot's fdtfile uses (boot.cmd)
BR2_LINUX_KERNEL_DTB_KEEP_DIRNAME=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# Kernel and device tree go in the root filesystem's /boot, so each of the two root
# slots (genimage.cfg) carries its own, as A/B updates need
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Bootloader chain: TF-A BL31 + U-Boot SPL
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_VERSION=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_VERSION_VALUE="v2.12"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="sun50i_h616"
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2026.10"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="anbernic_rg35xx_h700"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_TETSU_PATH)/board/h700/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="u-boot-sunxi-with-spl.bin"
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="SCP=/dev/null"

# GPU: OpenGL ES through Panfrost, which Buildroot only offers with LLVM. Mesa
# itself is built without it (external.mk), and post-build.sh removes the rest.
# kmscube is the test program.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_KMSCUBE=y

# Wi-Fi and Bluetooth chip: the Realtek RTL8821CS on SDIO. Its firmware and the
# regulatory database are built into the kernel (linux.fragment, external.mk),
# because the driver starts before the root filesystem is mounted.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
# mkimage, which makes each root slot's boot.scr (post-build.sh)
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
