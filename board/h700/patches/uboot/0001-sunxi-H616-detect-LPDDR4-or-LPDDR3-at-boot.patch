+};
+
+/*
+ * Tries LPDDR4 without stopping on a failure, and returns its size, or 0.
+ * Only the full 32-bit bus counts: LPDDR3 might train on half of it as
+ * LPDDR4, and a board sold with either type has both on the full bus.
+ * The size check at the end also catches settings that trained but don't
+ * hold data.
+ */
+static unsigned long mctl_try_lpddr4(struct dram_config *config)
+{
+	unsigned long size = 0;
+
+	mctl_trying = true;
+
+	config->cols = 8;
+	config->rows = 13;
+	config->bus_full_width = 1;
+
+	config->ranks = 2;
+	if (!mctl_core_init(&para_lpddr4, config)) {
+		config->ranks = 1;
+		if (!mctl_core_init(&para_lpddr4, config))
+			goto out;
+	}
+
+	mctl_auto_detect_dram_size(&para_lpddr4, config);
+
+	if (mctl_core_init(&para_lpddr4, config))
+		size = mctl_calc_size(config);
+
+out:
+	mctl_trying = false;
+	mctl_try_failed = false;
+
+	return size;
 }
 
+unsigned long sunxi_dram_init(void)
+{
+	void *const prcm = (void *)SUNXI_PRCM_BASE;
+	struct dram_config config;
+	unsigned long size;
+
+	setbits_le32(prcm + CCU_PRCM_RES_CAL_CTRL, BIT(8));
+	clrbits_le32(prcm + CCU_PRCM_OHMS240, 0x3f);
+
+	size = mctl_try_lpddr4(&config);
+	if (size) {
+		printf(" LPDDR4");
+	} else {
+#ifdef CONFIG_AXP_DCDC3_VOLT
+		/* LPDDR3 needs more than LPDDR4, which mustn't see this. */
+		axp_set_dcdc3(CONFIG_DRAM_SUNXI_LPDDR3_VOLT);
+		udelay(1000);
+#endif
+		mctl_auto_detect_rank_width(&para_lpddr3, &config);
+		mctl_auto_detect_dram_size(&para_lpddr3, &config);
+
+		mctl_core_init(&para_lpddr3, &config);
+
+		size = mctl_calc_size(&config);
+		printf(" LPDDR3");
+	}
+
+	mctl_set_master_priority();
+
+	return size;
+};
+#else
+
 static const struct dram_para para = {
 	.clk = CONFIG_DRAM_CLK,
 #ifdef CONFIG_SUNXI_DRAM_H616_DDR3_1333
@@ -1360,3 +1529,4 @@ unsigned long sunxi_dram_init(void)
 
 	return size;
 };
+#endif /* CONFIG_SUNXI_DRAM_H616_LPDDR4_OR_LPDDR3 */
