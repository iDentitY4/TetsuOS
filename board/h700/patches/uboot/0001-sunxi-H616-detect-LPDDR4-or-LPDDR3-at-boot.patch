+/*
+ * Waits for read calibration to finish, for up to 1s: false if it reports an
+ * error or never finishes, as with the wrong type of DRAM.
+ */
+static bool mctl_phy_await_read_calibration(u32 val)
+{
+	unsigned long tmo = timer_get_us() + 1000000;
+
+	while ((readl(SUNXI_DRAM_PHY0_BASE + 0x184) & val) != val) {
+		if (readl(SUNXI_DRAM_PHY0_BASE + 0x184) & 0x20)
+			return false;
+		if (timer_get_us() > tmo)
+			return false;
+	}
+
+	return true;
+}
