+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Both H616 LPDDR4 and LPDDR3 timings, for boards whose DRAM type is
+ * detected at boot (SUNXI_DRAM_H616_LPDDR4_OR_LPDDR3).
+ */
+
