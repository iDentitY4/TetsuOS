@@ -12,16 +12,33 @@
 #include <asm/io.h>
 #include <asm/arch/dram.h>
 
+/*
+ * Set while a DRAM type is only being tried: a timeout then marks the try
+ * as failed instead of stopping, and later waits of the same try return at
+ * once. The SPL's BSS is in DRAM, so these live in .data.
+ */
+bool mctl_trying __section(".data");
+bool mctl_try_failed __section(".data");
+
 /*
  * Wait up to 1s for value to be set in given part of reg.
  */
 void mctl_await_completion(u32 *reg, u32 mask, u32 val)
 {
-	unsigned long tmo = timer_get_us() + 1000000;
+	unsigned long tmo;
+
+	if (mctl_try_failed)
+		return;
 
+	tmo = timer_get_us() + 1000000;
 	while ((readl(reg) & mask) != val) {
-		if (timer_get_us() > tmo)
+		if (timer_get_us() > tmo) {
+			if (mctl_trying) {
+				mctl_try_failed = true;
+				return;
+			}
 			panic("Timeout initialising DRAM\n");
+		}
 	}
 }
 
