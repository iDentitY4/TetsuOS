+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * Copyright (C) 2024 Philippe Simons <simons.philippe@gmail.com>.
+ *
+ * The Anbernic RG40XX H, after ROCKNIX's device tree for it, with mainline's
+ * drivers for its sticks and panel.
+ */
+
+#include "sun50i-h700-anbernic-rg35xx-plus.dts"
+#include "sun50i-h700-anbernic-rg35xx-2024-sticks.dtsi"
+
+/ {
+	model = "Anbernic RG40XX H";
+	compatible = "anbernic,rg40xx-h", "allwinner,sun50i-h700";
+};
+
+/*
+ * The left stick's up and down and the right stick run the other way from the
+ * RG35XX H's; a tester's RG40XX H had up and down reversed (issue #30)
+ */
+&stick_ly {
+	abs-range = <4096 0>;
+};
+
+&stick_rx {
+	abs-range = <4096 0>;
+};
+
+&stick_ry {
+	abs-range = <0 4096>;
+};
+
+/*
+ * X is on PA2 and Y on PA3, as on the RG35XX SP: the shared device tree has them the
+ * other way round, which a tester's BUTTON TEST showed (issue #30)
+ */
+&gpio_keys_gamepad {
+	button-x {
+		gpios = <&pio 0 2 GPIO_ACTIVE_LOW>; /* PA2 */
+	};
+
+	button-y {
+		gpios = <&pio 0 3 GPIO_ACTIVE_LOW>; /* PA3 */
+	};
+};
+
+/* The vibration motor, on PWM channel 3 at PI13, as ROCKNIX's device tree has it */
+/ {
+	vibrator {
+		compatible = "pwm-vibrator";
+		pwms = <&pwm 3 1000000 0>;
+		pwm-names = "enable";
+		pinctrl-0 = <&pwm3_pi13_pin>;
+		pinctrl-names = "default";
+	};
+};
+
+&pio {
+	pwm3_pi13_pin: pwm3-pi13-pin {
+		pins = "PI13";
+		function = "pwm3";
+	};
+};
+
+&panel {
+	compatible = "anbernic,rg40xx-panel";
+};
