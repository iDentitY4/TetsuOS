Subject: [PATCH] mmc, init: identify the SD cards again when the root device is missing

On the Anbernic RG35XX SP the boot card's supply is the always-on vcc-io
rail, so Linux finds the card as U-Boot left it and can't power cycle it.
Once in a while, most often on the first cold start of a freshly written
SanDisk Ultra, its identification goes wrong: "new SD card at address
d555, SD032 30.6 MiB" instead of "new high speed SDHC card at address aaaa,
SD32G 29.7 GiB", with no partition table, so the kernel waits for its root
device forever. Taking the card out and putting it back made the boot carry
on every time.

wait_for_root() now identifies the SD memory cards again (dropping each card,
powering its host down and up, rescanning) when the root device hasn't
appeared 1 s after the drivers finished probing, then every 2 s, 3 times at
most. A start that finds its root device in time is unchanged. Card detect
interrupts stay as they are, and SDIO cards are left alone.

The kernel argument mmc_reidentify_test forces one identification before
the root device is looked up, to test this on a card that works.
---
diff --color -ruN a/drivers/mmc/core/core.c b/drivers/mmc/core/core.c
--- a/drivers/mmc/core/core.c
+++ b/drivers/mmc/core/core.c
@@ -2379,6 +2379,33 @@
 	_mmc_detect_change(host, 0, false);
 }
 
+/*
+ * Drops the SD memory card on @host and identifies it again, as taking it out
+ * and putting it back would, though without cutting its power. Card detect
+ * stays as it is. For a boot card read wrongly (see mmc_reidentify_sd_cards).
+ */
+void mmc_reidentify_sd_card(struct mmc_host *host)
+{
+	if (host->rescan_disable || !host->card || !mmc_card_sd(host->card))
+		return;
+
+	pr_warn("%s: identifying the SD card %s again\n", mmc_hostname(host),
+		dev_name(&host->card->dev));
+	cancel_delayed_work_sync(&host->detect);
+	if (host->bus_ops) {
+		/* Calling bus_ops->remove() with a claimed host can deadlock */
+		host->bus_ops->remove(host);
+		mmc_claim_host(host);
+		mmc_detach_bus(host);
+		mmc_power_off(host);
+		mmc_release_host(host);
+	}
+	mmc_claim_host(host);
+	mmc_power_up(host, host->ocr_avail);
+	mmc_release_host(host);
+	_mmc_detect_change(host, 0, false);
+}
+
 void __mmc_stop_host(struct mmc_host *host)
 {
 	if (host->rescan_disable)
diff --color -ruN a/drivers/mmc/core/core.h b/drivers/mmc/core/core.h
--- a/drivers/mmc/core/core.h
+++ b/drivers/mmc/core/core.h
@@ -77,6 +77,7 @@
 void mmc_start_host(struct mmc_host *host);
 void __mmc_stop_host(struct mmc_host *host);
 void mmc_stop_host(struct mmc_host *host);
+void mmc_reidentify_sd_card(struct mmc_host *host);
 
 void _mmc_detect_change(struct mmc_host *host, unsigned long delay,
 			bool cd_irq);
diff --color -ruN a/drivers/mmc/core/host.c b/drivers/mmc/core/host.c
--- a/drivers/mmc/core/host.c
+++ b/drivers/mmc/core/host.c
@@ -87,6 +87,26 @@
 	.pm		= pm_ptr(&mmc_host_class_dev_pm_ops),
 };
 
+static int mmc_reidentify_host(struct device *dev, void *data)
+{
+	mmc_reidentify_sd_card(cls_dev_to_mmc_host(dev));
+	return 0;
+}
+
+/**
+ * mmc_reidentify_sd_cards - identify every SD memory card again
+ *
+ * A boot card whose supply can't be switched off is found as the bootloader
+ * left it, and once in a while its identification goes wrong: on the Anbernic
+ * RG35XX SP a SanDisk Ultra read as "SD032, 30.6 MiB" with no partitions, so
+ * the root device never appeared. Taking the card out and putting it back
+ * fixed it; this does the same, minus the power cut. wait_for_root() calls it.
+ */
+void mmc_reidentify_sd_cards(void)
+{
+	class_for_each_device(&mmc_host_class, NULL, NULL, mmc_reidentify_host);
+}
+
 int mmc_register_host_class(void)
 {
 	return class_register(&mmc_host_class);
diff --color -ruN a/include/linux/mmc/host.h b/include/linux/mmc/host.h
--- a/include/linux/mmc/host.h
+++ b/include/linux/mmc/host.h
@@ -758,4 +758,6 @@
 int mmc_get_ext_csd(struct mmc_card *card, u8 **new_ext_csd);
 int mmc_read_tuning(struct mmc_host *host, unsigned int blksz, unsigned int blocks);
 
+void mmc_reidentify_sd_cards(void);
+
 #endif /* LINUX_MMC_HOST_H */
diff --color -ruN a/init/do_mounts.c b/init/do_mounts.c
--- a/init/do_mounts.c
+++ b/init/do_mounts.c
@@ -28,6 +28,10 @@
 
 #include "do_mounts.h"
 
+#if IS_BUILTIN(CONFIG_MMC)
+#include <linux/mmc/host.h>
+#endif
+
 int root_mountflags = MS_RDONLY | MS_SILENT;
 static char __initdata saved_root_name[64];
 static int root_wait;
@@ -403,9 +407,35 @@
 }
 
 /* wait for any asynchronous scanning to complete */
+#if IS_BUILTIN(CONFIG_MMC)
+/* Forces one identification of the SD cards again, to test it: mmc_reidentify_test */
+static bool __initdata mmc_reidentify_test;
+
+static int __init mmc_reidentify_test_setup(char *str)
+{
+	mmc_reidentify_test = true;
+	return 1;
+}
+__setup("mmc_reidentify_test", mmc_reidentify_test_setup);
+#endif
+
 static void __init wait_for_root(char *root_device_name)
 {
 	ktime_t end;
+#if IS_BUILTIN(CONFIG_MMC)
+	ktime_t reidentify = 0;
+	int reidentified = 0;
+#endif
+
+#if IS_BUILTIN(CONFIG_MMC)
+	/* The test: a card that worked, identified again before the root is found */
+	if (mmc_reidentify_test) {
+		wait_for_device_probe();
+		pr_warn("VFS: identifying the SD cards again, as mmc_reidentify_test asks\n");
+		mmc_reidentify_sd_cards();
+		ROOT_DEV = 0;
+	}
+#endif
 
 	if (ROOT_DEV != 0)
 		return;
@@ -416,6 +446,25 @@
 
 	while (!driver_probe_done() ||
 	       early_lookup_bdev(root_device_name, &ROOT_DEV) < 0) {
+#if IS_BUILTIN(CONFIG_MMC)
+		/*
+		 * An SD card that was identified wrongly never shows its
+		 * partitions: identify the cards again 1 s after the drivers
+		 * are done, then every 2 s, 3 times at most. A start that finds
+		 * its root device in time never gets here.
+		 */
+		if (driver_probe_done() && reidentified < 3) {
+			if (!reidentify)
+				reidentify = ktime_add_ms(ktime_get_raw(), 1000);
+			if (ktime_after(ktime_get_raw(), reidentify)) {
+				reidentified++;
+				pr_warn("VFS: %s not found, identifying the SD cards again (%d of 3)\n",
+					root_device_name, reidentified);
+				mmc_reidentify_sd_cards();
+				reidentify = ktime_add_ms(ktime_get_raw(), 2000);
+			}
+		}
+#endif
 		msleep(5);
 		if (root_wait > 0 && ktime_after(ktime_get_raw(), end))
 			break;
