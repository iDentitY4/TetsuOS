Subject: [PATCH] drm/panel: nv3052c: add the panel of newer RG35XX Plus, H and 2024 units

Units of the RG35XX Plus, H and 2024 from board revision 6 on have another
NV3052C panel, with its own setup and timings, on the same wires. It reports
the same ID as the older one, so the driver can't find it as it finds the
SP's second panel: panel_newvision_nv3052c.panel=rev6 on the command line
selects it, which Tetsu OS's boot script sets from a panel=rev6 line in
device.txt.

The setup is Hironori Kikuchi's YLM-LBV0345001H-V2, which he posted for this
driver to dri-devel in November 2024 (not merged), with the timings of
ROCKNIX's anbernic,rg35xx-plus-rev6-panel.panel, whose setup it is taken from.

Untested: no revision 6 unit has started this kernel.
---
diff --git a/drivers/gpu/drm/panel/panel-newvision-nv3052c.c b/drivers/gpu/drm/panel/panel-newvision-nv3052c.c
index 1f6880b98..43eb88007 100644
--- a/drivers/gpu/drm/panel/panel-newvision-nv3052c.c
+++ b/drivers/gpu/drm/panel/panel-newvision-nv3052c.c
@@ -44,6 +44,11 @@ struct nv3052c_panel_info {
 	unsigned int init_delay;
 	/* The panel to use if the one found doesn't identify as an NV3052C */
 	const struct nv3052c_panel_info *other;
+	/*
+	 * A later NV3052C panel on the same wires, which reports the same ID, so it is
+	 * only used when the command line says panel_newvision_nv3052c.panel=rev6
+	 */
+	const struct nv3052c_panel_info *rev6;
 };
 
 struct nv3052c {
@@ -603,6 +608,17 @@ static void nv3052c_detect(struct nv3052c *priv)
 	u8 *id;
 	int err;
 
+	if (!strcmp(panel_kind, "rev6")) {
+		if (priv->panel_info->rev6) {
+			priv->panel_info = priv->panel_info->rev6;
+			dev_info(priv->dev, "panel: rev6, set on the command line\n");
+			return;
+		}
+		/* Found as usual, and no longer reported as rev6 */
+		dev_warn(priv->dev, "panel: this panel has no rev6, finding it as usual\n");
+		panel_kind[0] = '\0';
+	}
+
 	if (!other)
 		return;
 
@@ -911,6 +927,188 @@ static const struct drm_display_mode rg35xx_sp_v2_mode[] = {
 	},
 };
 
