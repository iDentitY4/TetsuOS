Subject: [PATCH] drm/panel: nv3052c: find which panel an RG35XX SP has

The RG35XX SP was made with two panels on the same wires: an NV3052C and a
later one with another controller, which needs its own setup and timings.
Other systems ship a device tree for each and leave the choice to the user,
who sees a garbled picture until they guess right.

After a reset an NV3052C reports the ID 30 52 01 (the setup then replaces it),
so the driver now resets the panel at probe and reads it. A panel that doesn't
report it is given the second panel's setup, and an ID that can't be read keeps
the NV3052C's. The log says which it found. panel_newvision_nv3052c.panel=nv3052c
or =v2 on the kernel's command line overrides it, and the same parameter in sysfs
tells the launcher, as the second panel refreshes at 59.52 Hz.

The second panel's setup and timings are from ROCKNIX's
anbernic,rg35xx-sp-v2-panel.panel.
---
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
index fa8778ed..74fd93f6 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
@@ -87,3 +87,8 @@
 	vqmmc-supply = <&reg_cldo3>;
 	status = "okay";
 };
+
+/* The SP has one of two panels, which the driver tells apart by the panel's ID. */
+&panel {
+	compatible = "anbernic,rg35xx-sp-panel", "anbernic,rg35xx-plus-panel";
+};
diff --git a/drivers/gpu/drm/panel/panel-newvision-nv3052c.c b/drivers/gpu/drm/panel/panel-newvision-nv3052c.c
index 18130bc1..1da9e9b4 100644
--- a/drivers/gpu/drm/panel/panel-newvision-nv3052c.c
+++ b/drivers/gpu/drm/panel/panel-newvision-nv3052c.c
@@ -14,7 +14,9 @@
 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/regulator/consumer.h>
+#include <linux/slab.h>
 #include <linux/spi/spi.h>
+#include <linux/string.h>
 #include <video/mipi_display.h>
 #include <drm/drm_mipi_dbi.h>
 #include <drm/drm_modes.h>
@@ -32,6 +34,11 @@ struct nv3052c_panel_info {
 	u32 bus_format, bus_flags;
 	const struct nv3052c_reg *panel_regs;
 	unsigned int panel_regs_len;
+	/* A panel with another controller: commands, each after its length */
+	const u8 *init_seq;
+	size_t init_seq_len;
+	/* The panel to use if the one found doesn't identify as an NV3052C */
+	const struct nv3052c_panel_info *other;
 };
 
 struct nv3052c {
@@ -358,11 +365,51 @@ static const struct nv3052c_reg wl_355608_a8_panel_regs[] = {
 	{ 0xf6, 0xc0 },
 };
 
+/*
+ * What this panel is, read from the panel or set on the kernel's command line with
+ * panel_newvision_nv3052c.panel=nv3052c or =v2, and shown in sysfs for the launcher.
+ */
+static char panel_kind[8];
+module_param_string(panel, panel_kind, sizeof(panel_kind), 0444);
+MODULE_PARM_DESC(panel, "RG35XX SP: the panel fitted, nv3052c or v2 (default: read its ID)");
+
 static inline struct nv3052c *to_nv3052c(struct drm_panel *panel)
 {
 	return container_of(panel, struct nv3052c, panel);
 }
 
+/* Sets up a panel that has another controller, with the delays it needs. */
+static int nv3052c_init_other(struct nv3052c *priv)
+{
+	const struct nv3052c_panel_info *info = priv->panel_info;
+	struct mipi_dbi *dbi = &priv->dbi;
+	size_t i = 0;
+	int err;
+
+	msleep(120);
+
+	while (i < info->init_seq_len) {
+		u8 len = info->init_seq[i++];
+
+		err = mipi_dbi_command_stackbuf(dbi, info->init_seq[i], &info->init_seq[i + 1],
+						len - 1);
+		if (err) {
+			dev_err(priv->dev, "Unable to set register: %d\n", err);
+			return err;
+		}
+		i += len;
+	}
+
+	err = mipi_dbi_command(dbi, MIPI_DCS_EXIT_SLEEP_MODE);
+	if (err) {
+		dev_err(priv->dev, "Unable to exit sleep mode: %d\n", err);
+		return err;
+	}
+	msleep(120);
+
+	return 0;
+}
+
 static int nv3052c_prepare(struct drm_panel *panel)
 {
 	struct nv3052c *priv = to_nv3052c(panel);
@@ -380,10 +427,17 @@ static int nv3052c_prepare(struct drm_panel *panel)
 
 	/* Reset the chip */
 	gpiod_set_value_cansleep(priv->reset_gpio, 1);
-	usleep_range(10, 1000);
+	usleep_range(1000, 2000);
 	gpiod_set_value_cansleep(priv->reset_gpio, 0);
 	usleep_range(5000, 20000);
 
+	if (priv->panel_info->init_seq) {
+		err = nv3052c_init_other(priv);
+		if (err)
+			goto err_disable_regulator;
+		return 0;
+	}
+
 	/* Apply panel-specific initialization registers */
 	for (i = 0; i < panel_regs_len; i++) {
 		err = mipi_dbi_command(dbi, panel_regs[i].cmd,
@@ -428,6 +482,9 @@ static int nv3052c_unprepare(struct drm_panel *panel)
 	if (err)
 		dev_err(priv->dev, "Unable to enter sleep mode: %d\n", err);
 
+	if (priv->panel_info->init_seq)
+		msleep(120);
+
 	gpiod_set_value_cansleep(priv->reset_gpio, 1);
 	regulator_disable(priv->supply);
 
@@ -511,6 +568,86 @@ static const struct drm_panel_funcs nv3052c_funcs = {
 	.get_modes	= nv3052c_get_modes,
 };
 
+/* The ID an NV3052C reports after a reset; the setup then replaces it. */
+static bool nv3052c_id_matches(const u8 *id)
+{
+	return id[0] == 0x30 && id[1] == 0x52;
+}
+
+static int nv3052c_read_id(struct nv3052c *priv, u8 *id)
+{
+	static const u8 read_commands[] = { MIPI_DCS_GET_DISPLAY_ID, 0 };
+	int err;
+
+	priv->dbi.read_commands = read_commands;
+	err = mipi_dbi_command_buf(&priv->dbi, MIPI_DCS_GET_DISPLAY_ID, id, 3);
+	priv->dbi.read_commands = NULL;
+
+	return err;
+}
+
+/*
+ * The RG35XX SP was made with two panels, on the same wires and with nothing else to
+ * tell them apart. A panel that doesn't report an NV3052C's ID, even after waiting as
+ * long as the other panel needs, is taken for the other one. If the ID can't be read at
+ * all, the NV3052C's setup stays.
+ */
+static void nv3052c_detect(struct nv3052c *priv)
+{
+	const struct nv3052c_panel_info *other = priv->panel_info->other;
+	u8 *id;
+	int err;
+
+	if (!other)
+		return;
+
+	if (!strcmp(panel_kind, "v2")) {
+		priv->panel_info = other;
+		dev_info(priv->dev, "panel: v2, set on the command line\n");
+		return;
+	}
+	if (!strcmp(panel_kind, "nv3052c")) {
+		dev_info(priv->dev, "panel: NV3052C, set on the command line\n");
+		return;
+	}
+
+	id = kzalloc(3, GFP_KERNEL);
+	if (!id)
+		return;
+
+	err = regulator_enable(priv->supply);
+	if (err)
+		goto out_free;
+
+	gpiod_set_value_cansleep(priv->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(priv->reset_gpio, 0);
+	msleep(20);
+
+	err = nv3052c_read_id(priv, id);
+	if (!err && !nv3052c_id_matches(id)) {
+		msleep(130);
+		err = nv3052c_read_id(priv, id);
+	}
+
+	gpiod_set_value_cansleep(priv->reset_gpio, 1);
+	regulator_disable(priv->supply);
+
+	if (err) {
+		dev_warn(priv->dev, "panel: ID not read (%d), using the NV3052C's setup\n", err);
+	} else if (nv3052c_id_matches(id)) {
+		strscpy(panel_kind, "nv3052c");
+		dev_info(priv->dev, "panel: NV3052C, ID %3phN\n", id);
+	} else {
+		priv->panel_info = other;
+		strscpy(panel_kind, "v2");
+		dev_info(priv->dev, "panel: v2, ID %3phN\n", id);
+	}
+
+out_free:
+	kfree(id);
+}
+
 static int nv3052c_probe(struct spi_device *spi)
 {
 	struct device *dev = &spi->dev;
@@ -542,6 +679,8 @@ static int nv3052c_probe(struct spi_device *spi)
 
 	priv->dbi.read_commands = NULL;
 
+	nv3052c_detect(priv);
+
 	spi_set_drvdata(spi, priv);
 
 	err = drm_panel_of_backlight(&priv->panel);
@@ -619,6 +758,154 @@ static const struct drm_display_mode wl_355608_a8_mode[] = {
 	},
 };
 
