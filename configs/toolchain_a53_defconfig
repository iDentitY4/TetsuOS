# The cross toolchain for Cortex-A53 devices, such as the Allwinner H700 ones. The
# Makefile's toolchain target builds it once in output-toolchain/, and each board's
# buildroot.config uses it from there as an external toolchain.
BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_7_1=y
BR2_BINUTILS_VERSION_2_45_X=y
BR2_GCC_VERSION_15_X=y
# Nothing else: only the toolchain is built
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_TARGET_ROOTFS_TAR is not set
