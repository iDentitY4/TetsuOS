# CPU: Allwinner H700, quad Cortex-A53
BR2_aarch64=y
BR2_cortex_a53=y

# Toolchain: glibc, so emulators and libretro cores are straightforward later
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_7_1=y

# System
BR2_TARGET_GENERIC_HOSTNAME="rg35xxsp"
BR2_TARGET_GENERIC_ISSUE="RG35XX SP Linux"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
# USB-C debug console. Root has no password: development builds only.
BR2_TARGET_GENERIC_GETTY_PORT="ttyGS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
# Waits for Enter, so the PC can't echo the login prompt back as a username
BR2_TARGET_GENERIC_GETTY_OPTIONS="-w"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_RG35XXSP_PATH)/board/rg35xxsp/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RG35XXSP_PATH)/board/rg35xxsp/rootfs-overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RG35XXSP_PATH)/board/rg35xxsp/post-image.sh"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RG35XXSP_PATH)/board/rg35xxsp/busybox.fragment"

# Kernel: 7.2.15 is the base the display patches were checked against
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.2.15"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_RG35XXSP_PATH)/board/rg35xxsp/linux.defconfig"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RG35XXSP_PATH)/board/rg35xxsp/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/sun50i-h700-anbernic-rg35xx-sp"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Filesystems and SD image tooling
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# Bootloader chain: TF-A BL31 + U-Boot SPL
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_VERSION=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_VERSION_VALUE="v2.12"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="sun50i_h616"
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2026.10"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="anbernic_rg35xx_h700"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RG35XXSP_PATH)/board/rg35xxsp/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="u-boot-sunxi-with-spl.bin"
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="SCP=/dev/null"

# Welcome screen
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_WELCOME=y

# Game Boy Advance emulator, loaded by the welcome app
BR2_PACKAGE_LIBRETRO_MGBA=y
# First-generation Tamagotchi emulator, loaded the same way
BR2_PACKAGE_LIBRETRO_TAMALIB=y

# GPU: OpenGL ES through Panfrost, which Buildroot only offers with LLVM.
# kmscube is the test program.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_KMSCUBE=y

# Audio tools, for setting levels and testing playback
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# SSH and rsync over the USB network link, for scripts/push.sh
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_RSYNC=y
