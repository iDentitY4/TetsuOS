# The part of the Buildroot configuration that every device shares. The Makefile
# puts board/<board>/buildroot.config after it to make the full configuration.

# System
BR2_TARGET_GENERIC_ISSUE="Tetsu OS"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
# USB-C debug console. Root has no password: development builds only.
BR2_TARGET_GENERIC_GETTY_PORT="ttyGS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
# Waits for Enter, so the PC can't echo the login prompt back as a username
BR2_TARGET_GENERIC_GETTY_OPTIONS="-w"

# Compiler cache, kept across cleans; Rust code doesn't use it
BR2_CCACHE=y
BR2_CCACHE_DIR="$(BR2_EXTERNAL_TETSU_PATH)/ccache"

# Filesystems and SD image tooling
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"
BR2_TARGET_ROOTFS_EXT2_LABEL="TETSU-ROOT"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
# fsck.fat checks TETSU-DATA after USB STORAGE
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# Game launcher and libretro frontend
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_LAUNCHER=y

# Game Boy Advance emulator, loaded by the launcher
BR2_PACKAGE_LIBRETRO_MGBA=y
# First-generation Tamagotchi emulator, loaded the same way
BR2_PACKAGE_LIBRETRO_TAMALIB=y
# NES and SNES emulators. mGBA also runs Game Boy and Game Boy Color games
BR2_PACKAGE_LIBRETRO_FCEUMM=y
BR2_PACKAGE_LIBRETRO_SNES9X=y
# PlayStation emulator
BR2_PACKAGE_LIBRETRO_PCSX_REARMED=y
# Sega Mega Drive, Master System and Game Gear emulator
BR2_PACKAGE_LIBRETRO_GENESIS_PLUS_GX=y
# PC Engine emulator
BR2_PACKAGE_LIBRETRO_BEETLE_PCE_FAST=y
# Neo Geo Pocket, WonderSwan and Atari Lynx emulators
BR2_PACKAGE_LIBRETRO_BEETLE_NGP=y
BR2_PACKAGE_LIBRETRO_BEETLE_WSWAN=y
BR2_PACKAGE_LIBRETRO_HANDY=y
# Game engines rather than emulators: Cave Story, with its freeware data, and Doom,
# with Freedoom's two games
BR2_PACKAGE_LIBRETRO_NXENGINE=y
BR2_PACKAGE_LIBRETRO_PRBOOM=y
BR2_PACKAGE_FREEDOOM=y

# Audio tools, for setting levels and testing playback
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# SSH and rsync over the USB network link, for scripts/push.sh
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_RSYNC=y

# Wi-Fi. The chip's firmware is in the board's configuration. WPA3 would need OpenSSL.
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_MDNSD=y

# Bluetooth: BlueZ with D-Bus, for controllers and headphones. Neither starts
# at boot (post-build.sh renames their init scripts); /usr/sbin/bluetooth starts
# them when the BLUETOOTH setting is on. bluetoothctl is for testing over SSH.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_MONITOR=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
# BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_NETWORK is not set
# Headphones: bluez-alsa plays A2DP through an ALSA device, with SBC, which every
# headset has. It starts with bluetoothd, from /usr/sbin/bluetooth.
BR2_PACKAGE_BLUEZ_ALSA=y
